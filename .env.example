# Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.

# Public URL of the site, used in emails and social previews.
SITE_URL=https://cirvola.vercel.app

# Where enquiries, ideas and network sign-ups are delivered.
CIRVOLA_INBOX=cirvola.zerowaste@gmail.com

# ── Email sending: pick ONE option ───────────────────────────────
# Option A (recommended, free): Gmail SMTP with an App Password.
#   1. Turn on 2-Step Verification for cirvola.zerowaste@gmail.com
#   2. Google Account → Security → App passwords → create one called "Website"
#   3. Paste the 16-character password below (no spaces)
GMAIL_USER=cirvola.zerowaste@gmail.com
GMAIL_APP_PASSWORD=

# Option B: Resend (https://resend.com). Needs a verified domain to email people other than yourself.
# RESEND_API_KEY=
# RESEND_FROM="Cirvola <hello@your-domain.com>"

# Send people a confirmation copy of their request (true/false).
SEND_CONFIRMATION=true

# ── AI Idea Studio and Lab (Claude API) ──────────────────────────
# Without a key the site runs in demo mode with sample visuals.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
